# PostgreSQL credentials used by Docker Compose.
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=replace-with-a-local-or-deployment-secret

# Sign Express session IDs. Use a long random value in each environment.
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Exact browser origin(s), comma-separated if there is more than one.
FRONTEND_URL=http://localhost:8080

# Optional host ports for local development.
FRONTEND_PORT=8080
BACKEND_PORT=3000
DB_PORT=5432

# Supplier catalog API. Set the API key only in your local .env or deployment environment.
SUPPLIER_API_BASE_URL=
SUPPLIER_API_KEY=

# Algolia product search. Keep the admin key on the server; use a search-only key.
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_NAME=products

# Stripe Checkout. Use a Stripe test-mode secret key only for this assignment.
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:8080/order-confirmation/{ORDER_ID}?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:8080/checkout?payment=cancelled
STRIPE_WEBHOOK_SECRET=

# Supabase Storage for product images. Keep this key on the backend only.
SUPABASE_URL=
# Current Supabase Cloud secret key (sb_secret_...). Send via apikey header only.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=product-images
# Public URL reachable by shop visitors over HTTPS in production.
SUPABASE_PUBLIC_URL=

# PostNord sandbox. Keep the test API key on the backend only.
POSTNORD_API_BASE_URL=https://atapi2.postnord.com
POSTNORD_API_KEY=
# Used by the Delivery Options API; keep it on the backend.
POSTNORD_CUSTOMER_KEY=
# The Swedish postal code where the shop hands parcels to PostNord.
POSTNORD_ORIGIN_POSTAL_CODE=

# Shipping prices are whole SEK amounts; free shipping uses merchandise subtotal.
SHIPPING_SERVICE_POINT_PRICE_SEK=59
SHIPPING_HOME_PRICE_SEK=99
SHIPPING_FREE_THRESHOLD_SEK=500
